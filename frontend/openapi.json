{
 "openapi": "3.1.0",
 "info": {
  "title": "Sunstone",
  "version": "0.1.0"
 },
 "paths": {
  "/api/topology": {
   "get": {
    "summary": "Get Topology",
    "description": "Return the whole topology.",
    "operationId": "get_topology_api_topology_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Topology"
        }
       }
      }
     }
    }
   }
  },
  "/api/layouts": {
   "get": {
    "summary": "List Layouts",
    "description": "List saved layouts, most recently saved first.",
    "operationId": "list_layouts_api_layouts_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/LayoutSummary"
         },
         "type": "array",
         "title": "Response List Layouts Api Layouts Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/layouts/{name}": {
   "get": {
    "summary": "Get Layout",
    "description": "Return one saved layout.",
    "operationId": "get_layout_api_layouts__name__get",
    "parameters": [
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 1,
       "maxLength": 64,
       "title": "Name"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SavedLayout"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "put": {
    "summary": "Put Layout",
    "description": "Save a layout, replacing any with the same name.",
    "operationId": "put_layout_api_layouts__name__put",
    "parameters": [
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 1,
       "maxLength": 64,
       "title": "Name"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/LayoutIn"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SavedLayout"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "delete": {
    "summary": "Delete Layout",
    "description": "Delete a saved layout.",
    "operationId": "delete_layout_api_layouts__name__delete",
    "parameters": [
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 1,
       "maxLength": 64,
       "title": "Name"
      }
     }
    ],
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Circuit": {
    "properties": {
     "provider": {
      "type": "string",
      "title": "Provider"
     },
     "circuit_id": {
      "type": "string",
      "title": "Circuit Id"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "provider",
     "circuit_id"
    ],
    "title": "Circuit",
    "description": "A carrier circuit carrying a WAN link."
   },
   "Device": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "site": {
      "type": "string",
      "title": "Site"
     },
     "role": {
      "type": "string",
      "enum": [
       "wan-edge",
       "core",
       "distribution",
       "access"
      ],
      "title": "Role"
     },
     "platform": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Platform"
     },
     "mgmt_ip": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Mgmt Ip"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "name",
     "site",
     "role"
    ],
    "title": "Device",
    "description": "A network device at one site."
   },
   "DeviceCenter": {
    "properties": {
     "kind": {
      "type": "string",
      "const": "device",
      "title": "Kind"
     },
     "id": {
      "type": "string",
      "title": "Id"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "kind",
     "id"
    ],
    "title": "DeviceCenter",
    "description": "A neighborhood built around one device."
   },
   "Endpoint": {
    "properties": {
     "device": {
      "type": "string",
      "title": "Device"
     },
     "interface": {
      "type": "string",
      "title": "Interface"
     },
     "lag": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Lag"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "device",
     "interface"
    ],
    "title": "Endpoint",
    "description": "One end of a link: a device's interface, optionally a LAG member."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LayoutIn": {
    "properties": {
     "settings": {
      "$ref": "#/components/schemas/LayoutSettings"
     },
     "positions": {
      "additionalProperties": {
       "$ref": "#/components/schemas/Position"
      },
      "type": "object",
      "maxProperties": 20000,
      "title": "Positions"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "settings",
     "positions"
    ],
    "title": "LayoutIn",
    "description": "A layout as the browser sends it."
   },
   "LayoutSettings": {
    "properties": {
     "scope": {
      "type": "string",
      "enum": [
       "network",
       "neighborhood",
       "path"
      ],
      "title": "Scope"
     },
     "layout": {
      "type": "string",
      "enum": [
       "force",
       "radial"
      ],
      "title": "Layout"
     },
     "grouped": {
      "type": "boolean",
      "title": "Grouped"
     },
     "hops": {
      "type": "integer",
      "maximum": 4.0,
      "minimum": 1.0,
      "title": "Hops"
     },
     "center": {
      "anyOf": [
       {
        "oneOf": [
         {
          "$ref": "#/components/schemas/DeviceCenter"
         },
         {
          "$ref": "#/components/schemas/SiteCenter"
         },
         {
          "$ref": "#/components/schemas/LinksCenter"
         }
        ],
        "discriminator": {
         "propertyName": "kind",
         "mapping": {
          "device": "#/components/schemas/DeviceCenter",
          "links": "#/components/schemas/LinksCenter",
          "site": "#/components/schemas/SiteCenter"
         }
        }
       },
       {
        "type": "null"
       }
      ],
      "title": "Center"
     },
     "path": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/PathEnds"
       },
       {
        "type": "null"
       }
      ]
     },
     "expanded": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 10000,
      "title": "Expanded"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "scope",
     "layout",
     "grouped",
     "hops"
    ],
    "title": "LayoutSettings",
    "description": "The topology view's settings when the layout was saved."
   },
   "LayoutSummary": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "saved_at": {
      "type": "string",
      "format": "date-time",
      "title": "Saved At"
     },
     "scope": {
      "type": "string",
      "title": "Scope"
     },
     "nodes": {
      "type": "integer",
      "title": "Nodes"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "name",
     "saved_at",
     "scope",
     "nodes"
    ],
    "title": "LayoutSummary",
    "description": "A stored layout without its positions, for listing."
   },
   "Link": {
    "properties": {
     "a": {
      "$ref": "#/components/schemas/Endpoint"
     },
     "b": {
      "$ref": "#/components/schemas/Endpoint"
     },
     "speed_mbps": {
      "type": "integer",
      "exclusiveMinimum": 0.0,
      "title": "Speed Mbps"
     },
     "kind": {
      "type": "string",
      "enum": [
       "lan",
       "wan"
      ],
      "title": "Kind",
      "default": "lan"
     },
     "circuit": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Circuit"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string",
      "title": "Id",
      "description": "Stable identifier that does not depend on which end is listed first.\n\nReturns:\n    The two ``device:interface`` ends, sorted and joined with ``--``.",
      "readOnly": true
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "a",
     "b",
     "speed_mbps",
     "id"
    ],
    "title": "Link",
    "description": "A physical connection between two device interfaces."
   },
   "LinksCenter": {
    "properties": {
     "kind": {
      "type": "string",
      "const": "links",
      "title": "Kind"
     },
     "ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Ids"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "kind",
     "ids"
    ],
    "title": "LinksCenter",
    "description": "A neighborhood built around the ends of some links."
   },
   "PathEnds": {
    "properties": {
     "from": {
      "type": "string",
      "title": "From"
     },
     "to": {
      "type": "string",
      "title": "To"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "from",
     "to"
    ],
    "title": "PathEnds",
    "description": "The two devices whose shortest paths are shown."
   },
   "Position": {
    "properties": {
     "x": {
      "type": "number",
      "title": "X"
     },
     "y": {
      "type": "number",
      "title": "Y"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "x",
     "y"
    ],
    "title": "Position",
    "description": "Where a node was drawn."
   },
   "SavedLayout": {
    "properties": {
     "settings": {
      "$ref": "#/components/schemas/LayoutSettings"
     },
     "positions": {
      "additionalProperties": {
       "$ref": "#/components/schemas/Position"
      },
      "type": "object",
      "maxProperties": 20000,
      "title": "Positions"
     },
     "name": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "title": "Name"
     },
     "saved_at": {
      "type": "string",
      "format": "date-time",
      "title": "Saved At"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "settings",
     "positions",
     "name",
     "saved_at"
    ],
    "title": "SavedLayout",
    "description": "A stored layout."
   },
   "Site": {
    "properties": {
     "code": {
      "type": "string",
      "title": "Code"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "region": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Region"
     },
     "lat": {
      "type": "number",
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Lat"
     },
     "lon": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "code",
     "name",
     "lat",
     "lon"
    ],
    "title": "Site",
    "description": "A physical location with map coordinates."
   },
   "SiteCenter": {
    "properties": {
     "kind": {
      "type": "string",
      "const": "site",
      "title": "Kind"
     },
     "id": {
      "type": "string",
      "title": "Id"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "kind",
     "id"
    ],
    "title": "SiteCenter",
    "description": "A neighborhood built around every device of a site."
   },
   "Topology": {
    "properties": {
     "sites": {
      "items": {
       "$ref": "#/components/schemas/Site"
      },
      "type": "array",
      "title": "Sites"
     },
     "devices": {
      "items": {
       "$ref": "#/components/schemas/Device"
      },
      "type": "array",
      "title": "Devices"
     },
     "links": {
      "items": {
       "$ref": "#/components/schemas/Link"
      },
      "type": "array",
      "title": "Links"
     }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
     "sites",
     "devices",
     "links"
    ],
    "title": "Topology",
    "description": "A whole network: every site, device, and link."
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}
