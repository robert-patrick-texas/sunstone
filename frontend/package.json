{
	"name": "sunstone-web",
	"version": "0.0.0",
	"private": true,
	"description": "Sunstone web UI: a static SvelteKit single-page app served by the Sunstone backend.",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24.22.0 <25",
		"npm": ">=11.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"gen:api": "openapi-typescript ./openapi.json --output src/lib/api/schema.d.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"dependencies": {
		"cytoscape": "3.34.4",
		"cytoscape-fcose": "2.2.0",
		"maplibre-gl": "6.16.0"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/cytoscape-fcose": "2.2.5",
		"@types/node": "24.19.2",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	}
}
